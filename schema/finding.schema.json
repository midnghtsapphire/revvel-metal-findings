{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/midnghtsapphire/revvel-metal-findings/schema/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "lane", "status", "urls", "metal", "determinism", "revvel_hit", "honesty"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "lane": {
      "type": "string",
      "enum": [
        "00-near-metal",
        "01-deterministic-ai",
        "02-formal-replay",
        "03-agent-runtimes",
        "04-spec-to-code",
        "05-trials-papers"
      ]
    },
    "status": { "type": "string", "enum": ["active", "watching", "trial", "dropped"] },
    "urls": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1 },
    "license": { "type": "string" },
    "metal": { "type": "integer", "minimum": 1, "maximum": 5 },
    "determinism": { "type": "integer", "minimum": 1, "maximum": 5 },
    "revvel_hit": {
      "type": "string",
      "description": "Exact SSOT path or label this finding should change. No second pipeline."
    },
    "honesty": { "type": "string", "enum": ["CAN", "CAN-PARTIAL", "CANNOT", "UNKNOWN"] },
    "acquired": { "type": "string", "format": "date" }
  }
}
